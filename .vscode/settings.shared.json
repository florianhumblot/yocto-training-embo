{
    "python.autoComplete.extraPaths": [
        "${workspaceFolder}/sources/poky/bitbake/lib",
        "${workspaceFolder}/sources/poky/meta/lib",
        "${workspaceFolder}/layers/openembedded-core//poky/bitbake/lib",
        "${workspaceFolder}/layers/openembedded-core/poky/meta/lib",
        "${workspaceFolder}/layers/openembedded-core/bitbake/lib",
        "${workspaceFolder}/layers/openembedded-core/meta/lib"
    ],
    "python.analysis.extraPaths": [
        "${workspaceFolder}/sources/poky/bitbake/lib",
        "${workspaceFolder}/sources/poky/meta/lib",
        "${workspaceFolder}/layers/openembedded-core//poky/bitbake/lib",
        "${workspaceFolder}/layers/openembedded-core/poky/meta/lib",
        "${workspaceFolder}/layers/openembedded-core/bitbake/lib",
        "${workspaceFolder}/layers/openembedded-core/meta/lib"
    ],
    "files.associations": {
        "flake.lock": "json",
        "*.conf": "bitbake",
        "*.inc": "bitbake"
    },
    "files.watcherExclude": {
        "**/build": true
    },
    "search.exclude": {
        "**/build": true
    },
    "C_Cpp.files.exclude": {
        "**/build": true
    },
    "python.analysis.exclude": [
        "**/build"
    ],
    "git.repositoryScanIgnoredFolders": [
        "**/build"
    ],
    "bitbake.pathToBitbakeFolder": "${workspaceFolder}/layers/openembedded-core/bitbake",
    "bitbake.buildConfigurations": [
        {
            "name": "qemu",
            "commandWrapper": "kas shell config/emu.yml:config/debug.yml -c"
        },
        {
            "name": "avenger96",
            "commandWrapper": "kas shell config/avenger96.yml:config/debug.yml -c"
        }
    ]
}